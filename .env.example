# Infrastructure .env — скопируй в .env и задай свои значения
# UID/GID — заполняются автоматически через make install (совпадают с хост-пользователем)
UID=1000
GID=1000

NGINX_PORT=8080

POSTGRES_PORT=5432
POSTGRES_DB=laravel
POSTGRES_USER=laravel
POSTGRES_PASSWORD=change_me

REDIS_PORT=6379

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
